@@ -45,0 +46,25 @@ namespace ul::menu::smi {
+    inline Result QueryCatalogGameCardApplication(const u64 app_id, CatalogGameCardInfo &info) {
+        return SendCommand(SystemMessage::QueryCatalogGameCardApplication,
+            [&](ScopedStorageWriter &writer) {
+                return writer.Push(app_id);
+            },
+            [&](ScopedStorageReader &reader) {
+                UL_RC_TRY(reader.Pop(info));
+                // An older uSystem does not return this typed reply.
+                return (info.application_id == app_id && info.name[sizeof(info.name) - 1] == '\0')
+                    ? ResultSuccess : ResultCatalogLaunchDenied;
+            }
+        );
+    }
+
+    inline Result LaunchCatalogGameCardApplication(const u64 app_id) {
+        return SendCommand(SystemMessage::LaunchCatalogGameCardApplication,
+            [&](ScopedStorageWriter &writer) {
+                return writer.Push(app_id);
+            },
+            [](ScopedStorageReader &) {
+                return ResultSuccess;
+            }
+        );
+    }
+
