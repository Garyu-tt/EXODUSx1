+    bool CheckLocalCatalogGameCard(const u64 app_id, ul::smi::CatalogGameCardInfo *info = nullptr) {
+        using namespace exodus::home;
+        if(!IsApplicationProgramId(app_id) || app::IsActive()) {
+            return false;
+        }
+
+        bool inserted = false;
+        std::array<u64, 64> card_ids{};
+        s32 card_count = 0;
+        if(R_FAILED(nsIsGameCardInserted(&inserted)) || !inserted ||
+            R_FAILED(nsListApplicationIdOnGameCard(card_ids.data(), static_cast<s32>(card_ids.size()), &card_count)) ||
+            card_count <= 0 || static_cast<size_t>(card_count) > card_ids.size()) {
+            return false;
+        }
+        const auto card_end = card_ids.begin() + card_count;
+        const auto card_id = std::find(card_ids.begin(), card_end, app_id);
+        if(card_id == card_end) {
+            return false;
+        }
+
+        const auto records = ul::os::ListApplicationRecords();
+        const auto record = std::find_if(records.begin(), records.end(),
+            [app_id](const NsExtApplicationRecord &item) { return item.id == app_id; });
+        NsApplicationView view{};
+        if(record == records.end() || R_FAILED(nsGetApplicationView(&view, &app_id, 1)) ||
+            view.application_id != app_id) {
+            return false;
+        }
+
+        constexpr u32 required = NsExtApplicationViewFlag_IsValid | NsExtApplicationViewFlag_HasMainContents |
+            NsExtApplicationViewFlag_IsGameCard | NsExtApplicationViewFlag_IsGameCardInserted |
+            NsExtApplicationViewFlag_CanLaunch;
+        constexpr u32 blocked = NsExtApplicationViewFlag_IsDownloading | NsExtApplicationViewFlag_NeedsUpdate |
+            NsExtApplicationViewFlag_NeedsVerify | NsExtApplicationViewFlag_IsWaitingCommit1 |
+            NsExtApplicationViewFlag_IsWaitingCommit2 | NsExtApplicationViewFlag_IsWaitingCommit3 |
+            NsExtApplicationViewFlag_IsApplyingDelta;
+        if((view.flags & required) != required || (view.flags & blocked) != 0 ||
+            R_FAILED(nsCheckApplicationLaunchVersion(app_id))) {
+            return false;
+        }
+
+        const auto control = std::make_unique<NsApplicationControlData>();
+        u64 size = 0;
+        if(R_FAILED(nsGetApplicationControlData(NsApplicationControlSource_StorageOnly, app_id,
+            control.get(), sizeof(*control), &size)) || size < sizeof(NacpStruct) || size > sizeof(*control)) {
+            return false;
+        }
+        const auto license = control->nacp.required_network_service_license_on_launch == 0
+            ? StartupLicense::Local : StartupLicense::NetworkRequired;
+        const GameCardLaunchEvidence evidence{record->id, *card_id, view.application_id, true,
+            app::IsActive(), license, control->nacp.startup_user_account};
+        if(!MayLaunchCatalogGameCard(app_id, evidence)) {
+            return false;
+        }
+        if(info != nullptr) {
+            *info = {.application_id = app_id, .name = {}};
+            NacpLanguageEntry *language = nullptr;
+            if(R_SUCCEEDED(nacpGetLanguageEntry(&control->nacp, &language)) && language != nullptr) {
+                const auto *begin = language->name;
+                const auto *end = std::find(begin, begin + sizeof(language->name), '\0');
+                const auto count = std::min(static_cast<size_t>(end - begin), sizeof(info->name) - 1);
+                memcpy(info->name, begin, count);
+            }
+        }
+        return true;
+    }
+
+    std::optional<std::string> ResolveCatalogHomebrew(const std::string_view id) {
+        if(!accountUidIsValid(&g_SelectedUser)) {
+            return std::nullopt;
+        }
+        {
+            ul::ScopedLock lk(g_ConfigLock);
+            u64 configured_applet = 0;
+            if(!g_Config.GetEntry(ul::cfg::ConfigEntryId::HomebrewAppletTakeoverProgramId, configured_applet) ||
+                configured_applet != ul::la::LibraryAppletPhotoViewer) {
+                return std::nullopt;
+            }
+        }
+        return exodus::home::ResolveRegisteredHomebrewApplet(
+            ul::menu::MakeMenuPath(g_AmsIsEmuMMC, g_SelectedUser), id, ul::loader::NroPathSize,
+            static_cast<u32>(ul::menu::EntryType::Homebrew));
+    }
