index 4c5a30d..2897083 100755
--- a/projects/uMenu/include/ul/menu/smi/smi_Commands.hpp
+++ b/projects/uMenu/include/ul/menu/smi/smi_Commands.hpp
@@ -3,0 +4,3 @@
+#include <ul/menu/catalog_homebrew_policy.hpp>
+#include <array>
+#include <string_view>
@@ -45,0 +49,68 @@ namespace ul::menu::smi {
+    inline Result QueryCatalogGameCardApplication(const u64 app_id, CatalogGameCardInfo &info) {
+        return SendCommand(SystemMessage::QueryCatalogGameCardApplication,
+            [&](ScopedStorageWriter &writer) {
+                return writer.Push(app_id);
+            },
+            [&](ScopedStorageReader &reader) {
+                UL_RC_TRY(reader.Pop(info));
+                // An older uSystem does not return this typed reply.
+                return (info.application_id == app_id && info.name[sizeof(info.name) - 1] == '\0')
+                    ? ResultSuccess : ResultCatalogLaunchDenied;
+            }
+        );
+    }
+
+    inline Result LaunchCatalogGameCardApplication(const u64 app_id) {
+        return SendCommand(SystemMessage::LaunchCatalogGameCardApplication,
+            [&](ScopedStorageWriter &writer) {
+                return writer.Push(app_id);
+            },
+            [](ScopedStorageReader &) {
+                return ResultSuccess;
+            }
+        );
+    }
+
+    inline Result CatalogHomebrewAppletRequest(const std::string_view id, CatalogHomebrewAppletInfo *info = nullptr) {
+        std::array<char, loader::NroPathSize> payload{};
+        if(!exodus::home::IsCanonicalHomebrewAppletId(id, payload.size())) {
+            return ResultCatalogLaunchDenied;
+        }
+        memcpy(payload.data(), id.data(), id.size());
+        const auto command = info == nullptr ? SystemMessage::LaunchCatalogHomebrewApplet
+            : SystemMessage::QueryCatalogHomebrewApplet;
+        return SendCommand(command,
+            [&](ScopedStorageWriter &writer) {
+                return writer.Push(payload);
+            },
+            [&](ScopedStorageReader &reader) -> Result {
+                if(info == nullptr) {
+                    return ResultSuccess;
+                }
+                UL_RC_TRY(reader.Pop(*info));
+                if(info->path[sizeof(info->path) - 1] != '\0') {
+                    return ResultCatalogLaunchDenied;
+                }
+                const std::string_view path(info->path);
+                return exodus::home::HomebrewAppletPathMatches(id, path)
+                    ? ResultSuccess : ResultCatalogLaunchDenied;
+            }
+        );
+    }
+
+    inline Result QueryCatalogSteamLaunchStatus(const u32 app_id, CatalogSteamLaunchInfo &info) {
+        if(app_id == 0) {
+            return ResultCatalogLaunchDenied;
+        }
+        return SendCommand(SystemMessage::QueryCatalogSteamLaunchStatus,
+            [&](ScopedStorageWriter &writer) {
+                return writer.Push(app_id);
+            },
+            [&](ScopedStorageReader &reader) -> Result {
+                UL_RC_TRY(reader.Pop(info));
+                return (info.application_id == app_id && info.state == CatalogSteamLaunchState::NoApprovedSwitchRuntime)
+                    ? ResultSuccess : ResultCatalogLaunchDenied;
+            }
+        );
+    }
+
