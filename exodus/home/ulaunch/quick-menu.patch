+    bool MainMenuLayout::HandleLaunchEntry(const Entry &entry) {
+        auto do_launch_entry = true;
+
+        if(g_GlobalSettings.IsSuspended()) {
+            // Play animations, then resume the suspended hb/app
+            if(g_GlobalSettings.IsEntrySuspended(entry)) {
+                if(IsScreenCaptureBackgroundFocused()) {
+                    this->StartResume();
+                }
+                do_launch_entry = false;
+            }
+
+            // If the suspended entry is another one, ask the user to close it beforehand
+            // Homebrew launching code already does this checks later, this do this check only with apps
+            if(do_launch_entry && entry.Is<EntryType::Application>()) {
+                do_launch_entry = false;
+                this->HandleCloseSuspended();
+                do_launch_entry = !g_GlobalSettings.IsSuspended();
+            }
+        }
+
+        if(do_launch_entry && entry.Is<EntryType::Application>()) {
+            if(entry.app_info.NeedsVerify()) {
+                pu::audio::PlaySfx(this->error_sfx);
+
+                auto is_being_verified = false;
+                for(const auto app_id: g_GlobalSettings.in_verify_app_ids) {
+                    if(app_id == entry.app_info.app_id) {
+                        g_MenuApplication->ShowNotification(GetLanguageString("app_verify_wait"));
+                        is_being_verified = true;
+                        break;
+                    }
+                }
+
+                if(!is_being_verified) {
+                    const auto opt = g_MenuApplication->DisplayDialog(GetLanguageString("app_launch"), GetLanguageString("app_corrupted"), { GetLanguageString("yes"), GetLanguageString("cancel") }, true);
+                    if(opt == 0) {
+                        UL_RC_ASSERT(smi::StartVerifyApplication(entry.app_info.app_id));
+                        g_GlobalSettings.in_verify_app_ids.push_back(entry.app_info.app_id);
+                    }
+                }
+
+                do_launch_entry = false;
+            }
+            else if(entry.app_info.IsGameCardNotInserted()) {
+                pu::audio::PlaySfx(this->error_sfx);
+                g_MenuApplication->ShowNotification(GetLanguageString("app_no_gamecard"));
+                do_launch_entry = false;
+            }
+            else if(!entry.app_info.HasContents()) {
+                pu::audio::PlaySfx(this->error_sfx);
+                g_MenuApplication->ShowNotification(GetLanguageString("app_no_contents"));
+                do_launch_entry = false;
+            }
+            else if(!entry.app_info.CanBeLaunched()) {
+                UL_LOG_WARN("Tried to launch non-launchable application 0x%016lX with record last event %d and view flags 0x%D", entry.app_info.app_id, entry.app_info.record.last_event, entry.app_info.view.flags);
+                pu::audio::PlaySfx(this->error_sfx);
+                g_MenuApplication->ShowNotification(GetLanguageString("app_not_launchable"));
+                do_launch_entry = false;
+            }
+            else {
+                // Check if it can be launched
+                if(entry.app_info.IsNotUpdated()) {
+                    pu::audio::PlaySfx(this->error_sfx);
+                    const auto fail_rc = nsCheckApplicationLaunchVersion(entry.app_info.app_id);
+                    g_MenuApplication->ShowNotification(GetLanguageString("app_needs_update_cannot_launch") + ": " + util::FormatResultDisplay(fail_rc));
+                    do_launch_entry = false;
+                }
+                /*
+                else {
+                    const auto option = g_MenuApplication->DisplayDialog(GetLanguageString("app_launch"), GetLanguageString("app_needs_update_can_launch"), { GetLanguageString("ok"), GetLanguageString("cancel") }, true);
+                    do_launch_entry = option == 0;
+                }
+                */
+            }
+        }
+
+        if(do_launch_entry) {
+            if(entry.Is<EntryType::Homebrew>()) {
+                this->HandleHomebrewLaunch(entry);
+            }
+            else {
+                pu::audio::PlaySfx(this->launch_app_sfx);
+
+                g_MenuApplication->FadeOutToNonLibraryApplet();
+                return this->CompleteNativeApplicationLaunch(smi::LaunchApplication(entry.app_info.app_id));
+            }
+        }
+        return false;
+    }
+
+    bool MainMenuLayout::CompleteNativeApplicationLaunch(const Result rc) {
+        if(R_SUCCEEDED(rc)) {
+            g_MenuApplication->Finalize();
+            return true;
+        }
+        g_MenuApplication->FadeIn();
+        g_MenuApplication->ResetFade();
+        g_MenuApplication->ShowNotification(GetLanguageString("app_launch_error") + ": " + util::FormatResultDisplay(rc));
+        return false;
+    }
+
+    bool MainMenuLayout::CanLaunchCatalogApplication(const u64 app_id) {
+        smi::CatalogGameCardInfo info{};
+        return R_SUCCEEDED(smi::QueryCatalogGameCardApplication(app_id, info));
+    }
+
+    bool MainMenuLayout::TryLaunchCatalogApplication(const u64 app_id) {
+        smi::CatalogGameCardInfo info{};
+        if(R_FAILED(smi::QueryCatalogGameCardApplication(app_id, info))) {
+            g_MenuApplication->ShowNotification(GetLanguageString("exodus_catalog_title_unavailable"));
+            return false;
+        }
+        char id_text[17] = {};
+        std::snprintf(id_text, sizeof(id_text), "%016llX", static_cast<unsigned long long>(app_id));
+        const auto label = info.name[0] == '\0' ? std::string(id_text) : std::string(info.name) + "\n" + id_text;
+        const auto confirmed = g_MenuApplication->DisplayDialog(
+            GetLanguageString("exodus_catalog_launch"), label,
+            { GetLanguageString("exodus_catalog_launch"), GetLanguageString("cancel") }, true);
+        if(confirmed != 0) {
+            return false;
+        }
+        pu::audio::PlaySfx(this->launch_app_sfx);
+        g_MenuApplication->FadeOutToNonLibraryApplet();
+        return this->CompleteNativeApplicationLaunch(smi::LaunchCatalogGameCardApplication(app_id));
+    }
+
