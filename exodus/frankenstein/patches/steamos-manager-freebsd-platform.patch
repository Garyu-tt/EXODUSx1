index 0000000000000000000000000000000000000000..a68226e3d8ef98966d31add356c86ae2426ad994
--- /dev/null
+++ b/steamos-manager/examples/freebsd_inotify_probe.rs
@@ -0,0 +1,46 @@
+/*
+ * Copyright © 2026 EXODUS contributors
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+use inotify::{EventMask, Inotify, WatchMask};
+use std::ffi::OsStr;
+use std::io;
+use std::os::fd::{AsRawFd, FromRawFd};
+use tokio_stream::StreamExt;
+
+#[tokio::main]
+async fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let directory = tempfile::tempdir()?;
+    let original = Inotify::init()?;
+    let duplicate_fd = unsafe { libc::dup(original.as_raw_fd()) };
+    if duplicate_fd < 0 {
+        return Err(io::Error::last_os_error().into());
+    }
+    let duplicate = unsafe { Inotify::from_raw_fd(duplicate_fd) };
+
+    let original_watch = original
+        .watches()
+        .add(directory.path(), WatchMask::CREATE)?;
+    let duplicate_watch = duplicate
+        .watches()
+        .add(directory.path(), WatchMask::CREATE)?;
+    assert_eq!(
+        original_watch, duplicate_watch,
+        "duplicated descriptors must identify the same inotify watch"
+    );
+
+    let mut events = original.into_event_stream([0u8; 4096])?;
+    std::fs::write(directory.path().join("probe-event"), b"event")?;
+    let event = events
+        .next()
+        .await
+        .ok_or_else(|| io::Error::new(io::ErrorKind::UnexpectedEof, "inotify stream ended"))??;
+    assert_eq!(event.wd, original_watch);
+    assert!(event.mask.contains(EventMask::CREATE));
+    assert_eq!(event.name.as_deref(), Some(OsStr::new("probe-event")));
+
+    println!("EXODUS_MANAGER_INOTIFY_RUST_PASS");
+    Ok(())
+}
