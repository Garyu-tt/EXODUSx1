diff --git a/steamos-manager/src/cec_types.rs b/steamos-manager/src/cec_types.rs
new file mode 100644
index 0000000000000000000000000000000000000000..3d7af920df0a281d194d61d244e69d976b9b3bb5
--- /dev/null
+++ b/steamos-manager/src/cec_types.rs
@@ -0,0 +1,294 @@
+/*
+ * Copyright © 2026 EXODUS contributors
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+//! Target-specific CEC value types used by SteamOS Manager.
+//!
+//! Linux re-exports the original `linux-cec` types without wrapping them. The
+//! independently implemented FreeBSD values preserve only the address/OUI
+//! parse and serde contract that this crate consumes; no CEC device or ioctl
+//! API is exposed on FreeBSD.
+
+#[cfg(not(target_os = "freebsd"))]
+pub use linux_cec::{PhysicalAddress, VendorId};
+
+#[cfg(any(target_os = "freebsd", test))]
+mod portable {
+    use serde::de::{self, Unexpected, Visitor};
+    use serde::{Deserialize, Deserializer, Serialize, Serializer};
+    use std::fmt::{self, Display, Formatter};
+    use std::str::FromStr;
+
+    #[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+    #[repr(transparent)]
+    pub struct PhysicalAddress(u16);
+
+    impl PhysicalAddress {
+        pub const ROOT: Self = Self(0x0000);
+        pub const INVALID: Self = Self(0xffff);
+
+        #[must_use]
+        pub fn is_valid(&self) -> bool {
+            *self != Self::INVALID
+        }
+
+        #[must_use]
+        pub fn is_root(&self) -> bool {
+            *self == Self::ROOT
+        }
+    }
+
+    impl Default for PhysicalAddress {
+        fn default() -> Self {
+            Self::INVALID
+        }
+    }
+
+    impl From<u16> for PhysicalAddress {
+        fn from(value: u16) -> Self {
+            Self(value)
+        }
+    }
+
+    impl From<PhysicalAddress> for u16 {
+        fn from(value: PhysicalAddress) -> Self {
+            value.0
+        }
+    }
+
+    impl Display for PhysicalAddress {
+        fn fmt(&self, formatter: &mut Formatter<'_>) -> fmt::Result {
+            write!(
+                formatter,
+                "{:x}.{:x}.{:x}.{:x}",
+                self.0 >> 12,
+                (self.0 >> 8) & 0xf,
+                (self.0 >> 4) & 0xf,
+                self.0 & 0xf
+            )
+        }
+    }
+
+    #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+    pub struct ParseCecTypeError;
+
+    impl Display for ParseCecTypeError {
+        fn fmt(&self, formatter: &mut Formatter<'_>) -> fmt::Result {
+            formatter.write_str("invalid CEC identifier")
+        }
+    }
+
+    impl std::error::Error for ParseCecTypeError {}
+
+    impl FromStr for PhysicalAddress {
+        type Err = ParseCecTypeError;
+
+        fn from_str(value: &str) -> Result<Self, Self::Err> {
+            let compact = value.strip_prefix("0x").unwrap_or(value);
+            if compact.len() == 4
+                && let Ok(address) = u16::from_str_radix(compact, 16)
+            {
+                return Ok(Self(address));
+            }
+            let mut address = 0u16;
+            let mut count = 0usize;
+            for digit in value.split('.') {
+                if digit.len() != 1 || count == 4 {
+                    return Err(ParseCecTypeError);
+                }
+                let digit = u16::from_str_radix(digit, 16).map_err(|_| ParseCecTypeError)?;
+                address = (address << 4) | digit;
+                count += 1;
+            }
+            if count == 4 {
+                Ok(Self(address))
+            } else {
+                Err(ParseCecTypeError)
+            }
+        }
+    }
+
+    impl Serialize for PhysicalAddress {
+        fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>
+        where
+            S: Serializer,
+        {
+            serializer.serialize_str(&self.to_string())
+        }
+    }
+
+    struct PhysicalAddressVisitor;
+
+    impl<'de> Visitor<'de> for PhysicalAddressVisitor {
+        type Value = PhysicalAddress;
+
+        fn expecting(&self, formatter: &mut Formatter<'_>) -> fmt::Result {
+            formatter.write_str("a CEC physical address")
+        }
+
+        fn visit_u64<E>(self, value: u64) -> Result<Self::Value, E>
+        where
+            E: de::Error,
+        {
+            u16::try_from(value).map(PhysicalAddress).map_err(|_| {
+                de::Error::invalid_value(Unexpected::Unsigned(value), &"a 16-bit physical address")
+            })
+        }
+
+        fn visit_str<E>(self, value: &str) -> Result<Self::Value, E>
+        where
+            E: de::Error,
+        {
+            value.parse().map_err(|_| {
+                de::Error::invalid_value(Unexpected::Str(value), &"a CEC physical address")
+            })
+        }
+    }
+
+    impl<'de> Deserialize<'de> for PhysicalAddress {
+        fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>
+        where
+            D: Deserializer<'de>,
+        {
+            deserializer.deserialize_any(PhysicalAddressVisitor)
+        }
+    }
+
+    #[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+    pub struct VendorId(pub [u8; 3]);
+
+    impl From<VendorId> for u32 {
+        fn from(value: VendorId) -> Self {
+            (u32::from(value.0[0]) << 16) | (u32::from(value.0[1]) << 8) | u32::from(value.0[2])
+        }
+    }
+
+    impl FromStr for VendorId {
+        type Err = ParseCecTypeError;
+
+        fn from_str(value: &str) -> Result<Self, Self::Err> {
+            let mut bytes = [0u8; 3];
+            let mut count = 0usize;
+            for part in value.split('-') {
+                if part.len() != 2 || count == bytes.len() {
+                    return Err(ParseCecTypeError);
+                }
+                bytes[count] = u8::from_str_radix(part, 16).map_err(|_| ParseCecTypeError)?;
+                count += 1;
+            }
+            if count == bytes.len() {
+                Ok(Self(bytes))
+            } else {
+                Err(ParseCecTypeError)
+            }
+        }
+    }
+
+    impl Display for VendorId {
+        fn fmt(&self, formatter: &mut Formatter<'_>) -> fmt::Result {
+            write!(
+                formatter,
+                "{:02x}-{:02x}-{:02x}",
+                self.0[0], self.0[1], self.0[2]
+            )
+        }
+    }
+
+    impl Serialize for VendorId {
+        fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>
+        where
+            S: Serializer,
+        {
+            serializer.serialize_str(&self.to_string())
+        }
+    }
+
+    impl<'de> Deserialize<'de> for VendorId {
+        fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>
+        where
+            D: Deserializer<'de>,
+        {
+            let value = String::deserialize(deserializer)?;
+            value.parse().map_err(|_| {
+                de::Error::invalid_value(Unexpected::Str(&value), &"three hyphen-separated octets")
+            })
+        }
+    }
+}
+
+#[cfg(target_os = "freebsd")]
+pub(crate) use portable::{PhysicalAddress, VendorId};
+
+#[cfg(test)]
+mod tests {
+    use super::portable;
+    use std::str::FromStr;
+
+    #[test]
+    fn portable_physical_address_contract() {
+        for text in ["0x12ab", "12AB", "1.2.a.B", "0.0.0.0", "f.f.f.f"] {
+            let address = portable::PhysicalAddress::from_str(text).unwrap();
+            let encoded = serde_json::to_string(&address).unwrap();
+            let decoded: portable::PhysicalAddress = serde_json::from_str(&encoded).unwrap();
+            assert_eq!(decoded, address);
+        }
+        let numeric: portable::PhysicalAddress = serde_json::from_str("16").unwrap();
+        assert_eq!(u16::from(numeric), 16);
+        assert!(portable::PhysicalAddress::ROOT.is_root());
+        assert!(!portable::PhysicalAddress::INVALID.is_valid());
+        for invalid in ["0x123", "12345", "1.2.3", "1.2.3.4.5", "g.0.0.0"] {
+            assert!(portable::PhysicalAddress::from_str(invalid).is_err());
+        }
+        assert!(serde_json::from_str::<portable::PhysicalAddress>("65536").is_err());
+        assert!(serde_json::from_str::<portable::PhysicalAddress>("false").is_err());
+    }
+
+    #[test]
+    fn portable_vendor_id_contract() {
+        for text in ["e0-31-9e", "E0-31-9E", "00-00-00", "ff-ff-ff"] {
+            let vendor = portable::VendorId::from_str(text).unwrap();
+            let encoded = serde_json::to_string(&vendor).unwrap();
+            let decoded: portable::VendorId = serde_json::from_str(&encoded).unwrap();
+            assert_eq!(decoded, vendor);
+        }
+        for invalid in ["e0-31", "e0-31-9e-00", "e-31-9e", "gg-31-9e"] {
+            assert!(portable::VendorId::from_str(invalid).is_err());
+        }
+        assert!(serde_json::from_str::<portable::VendorId>("123").is_err());
+    }
+
+    #[cfg(not(target_os = "freebsd"))]
+    #[test]
+    fn portable_physical_address_matches_linux_type_contract() {
+        for text in ["0x12ab", "12AB", "1.2.a.B", "0.0.0.0", "f.f.f.f"] {
+            let portable = portable::PhysicalAddress::from_str(text).unwrap();
+            let linux = linux_cec::PhysicalAddress::from_str(text).unwrap();
+            assert_eq!(portable.to_string(), linux.to_string());
+            assert_eq!(u16::from(portable), u16::from(linux));
+            assert_eq!(
+                serde_json::to_string(&portable).unwrap(),
+                serde_json::to_string(&linux).unwrap()
+            );
+        }
+        let portable: portable::PhysicalAddress = serde_json::from_str("16").unwrap();
+        let linux: linux_cec::PhysicalAddress = serde_json::from_str("16").unwrap();
+        assert_eq!(u16::from(portable), u16::from(linux));
+    }
+
+    #[cfg(not(target_os = "freebsd"))]
+    #[test]
+    fn portable_vendor_id_matches_linux_type_contract() {
+        for text in ["e0-31-9e", "E0-31-9E", "00-00-00", "ff-ff-ff"] {
+            let portable = portable::VendorId::from_str(text).unwrap();
+            let linux = linux_cec::VendorId::from_str(text).unwrap();
+            assert_eq!(portable.to_string(), linux.to_string());
+            assert_eq!(u32::from(portable), u32::from(linux));
+            assert_eq!(
+                serde_json::to_string(&portable).unwrap(),
+                serde_json::to_string(&linux).unwrap()
+            );
+        }
+    }
+}
