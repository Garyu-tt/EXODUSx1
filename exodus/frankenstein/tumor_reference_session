#!/bin/sh
# PROVIDE: tumor_reference_session
# REQUIRE: tumor_reference_bus
# KEYWORD: shutdown
# Reference service: opt-in, fixed unprivileged test account.
. /etc/rc.subr
name=tumor_reference_session
rcvar=tumor_reference_session_enable
load_rc_config "$name"
: "${tumor_reference_session_enable:=NO}"
command=/usr/sbin/daemon
pidfile=/var/run/tumor-reference-session.supervisor.pid
command_args="-f -P $pidfile -p /var/run/tumor-reference-session.child.pid -u exodusref -o /var/log/tumor-reference-session.log /usr/bin/env DBUS_SESSION_BUS_ADDRESS=unix:path=/home/exodusref/.config/exodus/bus /usr/local/bin/exodus-sessiond-dbus /home/exodusref/.config/exodus/config"
start_precmd=session_pre
session_pre() {
    test "$(id -u exodusref)" -gt 0 || return 1
    su -m exodusref -c 'test -S /home/exodusref/.config/exodus/bus && test -r /home/exodusref/.config/exodus/config'
}
run_rc_command "$1"
